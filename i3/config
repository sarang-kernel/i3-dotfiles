set $mod Mod4

# Export graphical session env to systemd user services
exec --no-startup-id systemctl --user import-environment DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS XDG_CURRENT_DESKTOP
exec --no-startup-id dbus-update-activation-environment --systemd DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS XDG_CURRENT_DESKTOP
exec --no-startup-id sh -c 'export XDG_CURRENT_DESKTOP=i3'

exec --no-startup-id picom --config ~/.config/picom/picom.conf

# Kill existing polybar and start fresh
exec_always --no-startup-id sh -c "killall -q polybar; while pgrep -u $(id -u) -x polybar >/dev/null; do sleep 0.05; done; exec polybar -c ~/.config/polybar/config.ini toph"

