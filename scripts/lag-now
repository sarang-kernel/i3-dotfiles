#!/usr/bin/env bash
# lag-now: press the key when the machine lags. It takes a one-second snapshot of what the machine is doing and what the kernel
# remembers about the last few minutes (the kernel keeps pressure averages by itself, so nothing has to run in the background).
# Result: appended to ~/lag-notes.log. Tell me the time you pressed it.
out=$HOME/lag-notes.log
{
echo "=============== $(date '+%F %T')  $(cat /proc/sys/kernel/hostname)  up $(uptime -p)"
echo "-- stall pressure (share of time something waited; avg10 = last 10 s, avg60, avg300 = last 5 min)"
for k in cpu io memory; do printf "%-7s" "$k"; grep '^some' /proc/pressure/$k | sed 's/some //'; done
echo "-- busiest right now"
ps -eo pcpu,rss,stat,comm --sort=-pcpu --no-headers | head -6 | awk '{printf "  %5s%%  %6d MB  %-4s %s\n",$1,$2/1024,$3,$4}'
echo "-- waiting on disk (state D):"; ps -eo stat,comm --no-headers | awk '$1 ~ /^D/ {print "  " $2}' | sort | uniq -c | head -5
echo "-- biggest memory"
ps -eo rss,comm --sort=-rss --no-headers | head -3 | awk '{printf "  %6d MB  %s\n",$1/1024,$2}'
free -m | awk 'NR==2{printf "-- ram: %d used, %d available MB", $3, $7} NR==3{printf "; swap used %d MB\n", $3}'
echo "-- cpu: $(( $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq) / 1000 )) MHz now, governor $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor), epp $(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference 2>/dev/null || echo n/a)"
t=0; for f in /sys/devices/system/cpu/cpu*/thermal_throttle/core_throttle_count; do [ -r "$f" ] && t=$((t + $(cat $f))); done
echo "-- thermal throttle events since boot: $t   temps: $(sensors 2>/dev/null | grep -E '^(Package id 0|Tctl|Composite)' | tr -s ' ' | tr '\n' ' ')"
for g in /sys/class/drm/card*/device/gpu_busy_percent; do [ -r "$g" ] && echo "-- gpu busy: $(cat $g)% ($g)"; done
if command -v xrandr >/dev/null && [ -n "$DISPLAY" ]; then echo "-- display: $(xrandr --current | awk '/\*/{print $1, $2; exit}')"; fi
echo "-- kernel, last 3 min:"; journalctl -k --since "-3min" --no-pager -p warning 2>/dev/null | tail -5 | cut -c1-160
echo "-- services restarted or failed, last 5 min:"; journalctl --since "-5min" --no-pager 2>/dev/null | grep -E "Started |Failed |Stopped " | grep -v "Session\|user-runtime\|run-user\|run-r" | tail -6 | cut -c1-140
echo
} >> "$out"
command -v notify-send >/dev/null && : # silent on purpose: no popups
echo "saved to $out"
